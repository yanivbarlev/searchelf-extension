{
  "manifest_version": 3,
  "name": "Tips for Canva - Shortcuts & Hidden Features",
  "version": "1.0.0",
  "description": "Instantly discover useful tips, keyboard shortcuts, and hidden features while using Canva. Boost your design workflow.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "imgs/icon-16.png",
      "48": "imgs/icon-48.png",
      "128": "imgs/icon-128.png"
    }
  },
  "icons": {
    "16": "imgs/icon-16.png",
    "48": "imgs/icon-48.png",
    "128": "imgs/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.canva.com/*"],
      "js": ["js/cs.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.json", "css/widget.css"],
      "matches": ["*://*.canva.com/*"]
    }
  ]
}
